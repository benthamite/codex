#!/bin/sh

# Generic wrapper script for Codex CLI hooks using emacsclient.
#
# Usage: codex-hook-wrapper <hook-type> [--emacsclient PATH]
#                           [--socket-name SOCKET | --server-file FILE]
# The hook type is passed as the first argument (e.g., Stop, PreToolUse).
#
# Codex waits for every command hook, so a stalled Emacs server (a request
# parked in the debugger or at a prompt, or Emacs busy in long Lisp) would
# hold the Codex turn.  Only the hook types listed in
# CODEX_HOOK_ANSWER_TYPES (default: PermissionRequest) wait for Emacs, and
# for at most CODEX_HOOK_ANSWER_TIMEOUT seconds; when Emacs does not answer
# in time the hook exits 1, which Codex records as a failed hook without a
# decision, so it proceeds as if the hook were absent (for PermissionRequest,
# its own approval prompt).  Every other hook type is sent in the background
# and the wrapper exits at once with no output.

usage() {
    printf 'Usage: codex-hook-wrapper <hook-type> [--emacsclient PATH] [--socket-name SOCKET | --server-file FILE]\n' >&2
}

if [ "$#" -lt 1 ] || [ -z "${1:-}" ]; then
    usage
    exit 1
fi

hook_type=$1
shift

emacsclient_program=${CODEX_EMACSCLIENT:-emacsclient}
socket_name=${CODEX_EMACSCLIENT_SOCKET_NAME:-}
server_file=${CODEX_EMACSCLIENT_SERVER_FILE:-}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --emacsclient)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                usage
                exit 1
            fi
            emacsclient_program=$2
            shift 2
            ;;
        --socket-name)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                usage
                exit 1
            fi
            socket_name=$2
            shift 2
            ;;
        --server-file)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                usage
                exit 1
            fi
            server_file=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

resolve_local_socket_name() {
    case "$socket_name" in
        '' | /*)
            return
            ;;
    esac
    socket_dir=${CODEX_EMACSCLIENT_SOCKET_DIR:-}
    if [ -z "$socket_dir" ]; then
        darwin_tmp=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)
        [ -n "$darwin_tmp" ] && socket_dir="${darwin_tmp}emacs$(id -u)"
    fi
    [ -n "$socket_dir" ] && socket_name="${socket_dir%/}/$socket_name"
}

resolve_local_socket_name

if [ -z "${CODEX_BUFFER_NAME:-}" ]; then
    cat >/dev/null || true
    exit 0
fi

json_file=
response_file=
stderr_file=
cleanup() {
    [ -n "$json_file" ] && rm -f "$json_file"
    [ -n "$response_file" ] && rm -f "$response_file"
    [ -n "$stderr_file" ] && rm -f "$stderr_file"
}
trap cleanup EXIT

dispatch_failure_exit=1
gatekeeping_dispatch_failure_exit=2
answer_timeout_exit=1
dispatch_attempts=${CODEX_HOOK_DISPATCH_ATTEMPTS:-3}
dispatch_retry_delay=${CODEX_HOOK_DISPATCH_RETRY_DELAY:-0.15}
answer_types=${CODEX_HOOK_ANSWER_TYPES-PermissionRequest}
answer_timeout=${CODEX_HOOK_ANSWER_TIMEOUT:-5}
background_timeout=${CODEX_HOOK_BACKGROUND_TIMEOUT:-10}

positive_integer_or() {
    case "$1" in
        ''|*[!0-9]*|0)
            printf '%s\n' "$2"
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

dispatch_attempts=$(positive_integer_or "$dispatch_attempts" 3)
answer_timeout=$(positive_integer_or "$answer_timeout" 5)
background_timeout=$(positive_integer_or "$background_timeout" 10)

hook_needs_answer() {
    case " $answer_types " in
        *" $hook_type "*)
            return 0
            ;;
    esac
    return 1
}

json_file=$(mktemp "${TMPDIR:-/tmp}/codex-hook-json.XXXXXX") || exit 1
response_file=$(mktemp "${TMPDIR:-/tmp}/codex-hook-response.XXXXXX") || exit 1
stderr_file=$(mktemp "${TMPDIR:-/tmp}/codex-hook-stderr.XXXXXX") || exit 1
chmod 600 "$json_file" "$response_file" "$stderr_file" || exit 1

buffer_name=$CODEX_BUFFER_NAME

cat > "$json_file" || exit 1

# The send time lets Emacs order events that background delivery can
# reorder.  Without perl the event goes without one, and Emacs then
# applies it whatever its order.
sent_at=$(perl -MTime::HiRes=time -e 'printf "%.6f", time' 2>/dev/null) \
    || sent_at=

fail_for_dispatch_error() {
    message=$(cat "$stderr_file")
    if [ -z "$message" ]; then
        message="emacsclient hook dispatch failed"
    fi
    if should_fail_open_for_dispatch_error; then
        exit 0
    fi
    printf 'codex hook dispatch failed for %s: %s\n' "$hook_type" "$message" >&2
    case "$hook_type" in
        PreToolUse|PermissionRequest)
            # Codex treats exit 2 from gatekeeping hooks as a blocking
            # decision.  If Emacs cannot receive a tool-use or permission hook,
            # fail closed instead of silently allowing the action.
            exit "$gatekeeping_dispatch_failure_exit"
            ;;
        *)
            exit "$dispatch_failure_exit"
            ;;
    esac
}

should_fail_open_for_dispatch_error() {
    dispatch_error_is_transient || return 1
    case "$hook_type" in
        PreToolUse|PostToolUse|SessionStart|Stop|UserPromptSubmit|PreCompact|PostCompact)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

dispatch_error_is_transient() {
    grep -Eq "can't connect|Connection refused|No socket or alternate editor|No such file or directory" "$stderr_file"
}

dispatch_timed_out() {
    grep -q "Server not responding; timed out" "$stderr_file"
}

run_emacsclient_once() {
    : > "$stderr_file"
    if [ -n "$socket_name" ]; then
        "$emacsclient_program" --socket-name "$socket_name" \
          --timeout="$emacsclient_timeout" \
          --eval '(codex-handle-hook-from-emacsclient)' \
          "$hook_type" "$buffer_name" \
          json-file "$json_file" \
          response-file "$response_file" \
          ${sent_at:+sent-at "$sent_at"} \
          "$@" >/dev/null 2>"$stderr_file"
    elif [ -n "$server_file" ]; then
        "$emacsclient_program" --server-file "$server_file" \
          --timeout="$emacsclient_timeout" \
          --eval '(codex-handle-hook-from-emacsclient)' \
          "$hook_type" "$buffer_name" \
          json-file "$json_file" \
          response-file "$response_file" \
          ${sent_at:+sent-at "$sent_at"} \
          "$@" >/dev/null 2>"$stderr_file"
    else
        "$emacsclient_program" --timeout="$emacsclient_timeout" \
          --eval '(codex-handle-hook-from-emacsclient)' \
          "$hook_type" "$buffer_name" \
          json-file "$json_file" \
          response-file "$response_file" \
          ${sent_at:+sent-at "$sent_at"} \
          "$@" >/dev/null 2>"$stderr_file"
    fi
}

run_emacsclient_with_retry() {
    attempt=1
    while :; do
        if run_emacsclient_once "$@"; then
            return 0
        fi
        if [ "$attempt" -ge "$dispatch_attempts" ] || ! dispatch_error_is_transient; then
            return 1
        fi
        sleep "$dispatch_retry_delay"
        attempt=$((attempt + 1))
    done
}

# Hook JSON travels through a private temp file instead of argv, because hook
# input may contain secrets and can be larger than ARG_MAX.  The json-file,
# response-file and optional sent-at labels form the argv protocol parsed by
# `codex-handle-hook-from-emacsclient'.  A request that reaches Emacs after
# its emacsclient gave up finds the JSON file gone, and Emacs drops it.
if ! hook_needs_answer; then
    # The background job owns the temp files from here on.  Its output is
    # detached so that Codex, which reads the hook's stdout and stderr to
    # EOF, does not wait for it.
    trap - EXIT
    (
        trap cleanup EXIT
        emacsclient_timeout=$background_timeout
        run_emacsclient_with_retry "$@"
    ) </dev/null >/dev/null 2>&1 &
    exit 0
fi

emacsclient_timeout=$answer_timeout
if ! run_emacsclient_with_retry "$@"; then
    if dispatch_timed_out; then
        printf 'codex hook %s: Emacs did not answer within %ss; continuing without its answer\n' \
            "$hook_type" "$answer_timeout" >&2
        exit "$answer_timeout_exit"
    fi
    fail_for_dispatch_error
fi

if [ -s "$response_file" ]; then
    cat "$response_file"
fi
